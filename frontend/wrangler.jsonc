{
  // Cloudflare Workers deployment of the frontend.
  // Build settings in the dashboard: root directory "frontend",
  // build command "npm run build", deploy command "npx wrangler deploy".
  "name": "signwithme-v2",
  "main": "worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths fall through to the single-page app's router.
    "not_found_handling": "single-page-application",
    // API calls must reach worker.js instead of being answered with index.html.
    "run_worker_first": ["/api/*"]
  }
}
