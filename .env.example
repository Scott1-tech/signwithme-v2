# Copy to .env before the first `docker compose up`.
# Compose fails fast rather than starting Postgres and MinIO with empty passwords.

DB_PASSWORD=change-me-postgres

# Artefact storage. "local" writes PDFs to a docker volume and costs no memory;
# "s3" runs MinIO instead (start it with: docker compose --profile s3 up -d).
# On a 1 GB machine, keep this local.
STORAGE_BACKEND=local

# Only used when STORAGE_BACKEND=s3.
MINIO_USER=minioadmin
MINIO_PASSWORD=change-me-minio
MINIO_BUCKET=contracts

# Sign JWTs with a long random value in any real deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Encrypts SSNs, EINs and dates of birth at rest. Generate separately from
# JWT_SECRET; if unset, JWT_SECRET is used. Losing or rotating it makes existing
# encrypted values unreadable.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PII_ENCRYPTION_KEY=change-me-to-a-second-long-random-string

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Where the UI listens. Leave on loopback and reach it over a VPN (Tailscale,
# WireGuard); set to 0.0.0.0 only behind a TLS-terminating reverse proxy.
FRONTEND_BIND=127.0.0.1
DEBUG=false

# Self-registration only ever creates contractors, so the first admin is seeded.
# Outside DEBUG the app refuses to start with the example PII_ENCRYPTION_KEY and
# refuses to create the admin with the example password below: both values are
# public, so change them before the first `docker compose up`.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin
SEED_ADMIN_NAME=Administrator

# false = nobody can sign up; an admin creates every account
# (POST /api/auth/users). With true, a self-registered account still cannot open
# a contract addressed to its e-mail until an admin verifies that e-mail
# (POST /api/auth/users/{id}/verify-email).
ALLOW_SELF_REGISTRATION=true

# Reverse proxies whose X-Forwarded-For header is believed. The default is the
# frontend (nginx) container's fixed address from docker-compose.yml. Add the
# address of any proxy you put in front of it, comma-separated.
TRUSTED_PROXY_CIDRS=172.28.0.10/32
