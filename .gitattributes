# Scripts that run inside the Linux containers must keep LF line endings even
# when the repository is cloned on Windows (a CRLF `entrypoint.sh` fails with
# "no such file or directory" and the API never starts).
*.sh text eol=lf
*.py text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
# PowerShell scripts are for Windows.
*.ps1 text eol=crlf
